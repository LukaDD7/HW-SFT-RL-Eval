+_FINAL_ANSWER_PATTERNS = (
+    re.compile(r"<answer>\s*([A-E])\s*</answer>\s*$", re.IGNORECASE),
+    re.compile(r"(?:^|\n)\s*(?:answer>|\(answer\))\s*([A-E])\s*</answer>\s*$", re.IGNORECASE),
+    re.compile(r"(?:^|\n)\s*(?:answer|\(answer\))\s*\n\s*([A-E])\s*</answer>\s*$", re.IGNORECASE),
+    re.compile(r"(?:^|\n)\s*answer\s*\n\s*([A-E])\s*$", re.IGNORECASE),
+)
+
+
+def extract_final_answer(text):
+    """Extract only a terminal single-letter answer marker from model output."""
+    if not isinstance(text, str):
+        return False
+    for pattern in _FINAL_ANSWER_PATTERNS:
+        matches = list(pattern.finditer(text))
+        if matches:
+            return matches[-1].group(1).upper()
+    return False


